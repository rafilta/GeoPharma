@page
@model GeoPharma.Pages.Leads.IndexModel
@{
    ViewData["Title"] = "Leads Capturados";
}

<div class="container mt-4 pt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-bullseye text-danger me-2"></i> Leads Capturados</h2>
    </div>
    <hr />

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nome da Farmácia</th>
                        <th>Endereço</th>
                        <th>Responsável (Conta)</th>
                        <th>Status</th>
                        <th>Data de Captação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Leads != null && Model.Leads.Any())
                    {
                        @foreach (var item in Model.Leads)
                        {
                            <tr>
                                <td class="fw-bold">@item.Nome</td>
                                <td><small class="text-muted">@item.Endereco</small></td>
                                <td>
                                    <span class="badge bg-secondary"><i class="fas fa-user me-1"></i> @item.VendedorResponsavel</span>
                                </td>
                                <td>
                                    @if (item.Status == "EmAndamento")
                                    {
                                        <span class="badge bg-warning text-dark">Em Andamento</span>
                                    }
                                    else if (item.Status == "Convertido")
                                    {
                                        <span class="badge bg-success">Convertido (Cliente)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Não Qualificado</span>
                                    }
                                </td>
                                <td>@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i> Gerenciar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Nenhum lead capturado no mapa até o momento.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>