@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard - GeoPharma";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="fw-bold text-primary">Painel do GeoPharma</h2>
            <p class="text-muted">Bem-vindo ao sistema de geolocalização e gestão de estabelecimentos.</p>
        </div>
    </div>

    <!-- Cards de resumo (Exemplo visual para o Dashboard) -->
    <div class="row mt-3">
        <div class="col-md-4">
            <div class="card bg-primary text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Estabelecimentos</h5>
                    <p class="card-text fs-3 font-weight-bold">0</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Regiões</h5>
                    <p class="card-text fs-3 font-weight-bold">0</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Usuários Ativos</h5>
                    <p class="card-text fs-3 font-weight-bold">1</p>
                </div>
            </div>
        </div>
    </div>
</div>