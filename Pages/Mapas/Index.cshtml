                    marker.addTo(
                        oportunidadesLayer
                    );
                }
            );
    }


    // =============================================================
    // CAPTURAR
    // =============================================================

    async function capturarFarmacia(
        osmId) {

        const farmacia =
            farmaciasEncontradas
                .find(
                    f =>
                        f.osmId ===
                        osmId
                );


        if (!farmacia) {

            return;
        }


        if (
            !window.confirm(
                `Capturar "${farmacia.nome}" como lead?`
            )
        ) {

            return;
        }


        try {

            const response =
                await fetch(
                    "?handler=CapturarLead",
                    {
                        method:
                            "POST",

                        headers:
                        {
                            "Content-Type":
                                "application/json",

                            "RequestVerificationToken":
                                obterToken()
                        },

                        body:
                            JSON.stringify({
                                nome:
                                    farmacia.nome,

                                razaoSocial:
                                    farmacia.razaoSocial,

                                cnpj:
                                    farmacia.cnpj,

                                endereco:
                                    farmacia.endereco,

                                latitude:
                                    farmacia.latitude,

                                longitude:
                                    farmacia.longitude
                            })
                    }
                );


            const result =
                await response.json();


            if (!result.success) {

                mostrarToast(
                    result.message,
                    false
                );

                return;
            }


            leads.push({
                id:
                    result.lead.id,

                nome:
                    result.lead.nome,

                cnpj:
                    result.lead.cnpj,

                endereco:
                    result.lead.endereco,

                latitude:
                    result.lead.latitude,

                longitude:
                    result.lead.longitude,

                status:
                    result.lead.status,

                responsavel:
                    result.lead.responsavel,

                dataCaptura:
                    result.lead.dataCaptura
            });


            farmaciasEncontradas =
                farmaciasEncontradas
                    .filter(
                        f =>
                            f.osmId !==
                            osmId
                    );


            carregarLeads();

            desenharPossiveisLeads();

            atualizarKpis();

            map.closePopup();


            mostrarToast(
                result.message,
                true
            );

        }
        catch(error) {

            console.error(
                error
            );


            mostrarToast(
                "Não foi possível capturar o lead.",
                false
            );
        }
    }


    // =============================================================
    // STATUS
    // =============================================================

    async function atualizarStatus(
        leadId) {

        const select =
            document.getElementById(
                `statusLead_${leadId}`
            );


        if (!select) {
            return;
        }


        try {

            const response =
                await fetch(
                    "?handler=AtualizarStatus",
                    {
                        method:
                            "POST",

                        headers:
                        {
                            "Content-Type":
                                "application/json",

                            "RequestVerificationToken":
                                obterToken()
                        },

                        body:
                            JSON.stringify({
                                leadId:
                                    leadId,

                                status:
                                    select.value
                            })
                    }
                );


            const result =
                await response.json();


            if (!result.success) {

                mostrarToast(
                    result.message,
                    false
                );

                return;
            }


            const lead =
                leads.find(
                    l =>
                        l.id ===
                        leadId
                );


            if (lead) {

                lead.status =
                    result.status;
            }


            map.closePopup();

            carregarLeads();

            atualizarKpis();


            mostrarToast(
                result.message,
                true
            );

        }
        catch {

            mostrarToast(
                "Não foi possível atualizar o status.",
                false
            );
        }
    }


    // =============================================================
    // KPIS
    // =============================================================

    function atualizarKpis() {

        document
            .getElementById(
                "kpiPossiveis"
            )
            .textContent =
                farmaciasEncontradas.length;


        document
            .getElementById(
                "kpiLeads"
            )
            .textContent =
                leads.length;


        document
            .getElementById(
                "kpiAndamento"
            )
            .textContent =

                leads.filter(
                    l =>
                        l.status ===
                        "Em Andamento"
                ).length;


        document
            .getElementById(
                "kpiNegociando"
            )
            .textContent =

                leads.filter(
                    l =>
                        l.status ===
                        "Negociando"
                ).length;
    }


    // =============================================================
    // DISTÂNCIA
    // =============================================================

    function distanciaMetros(
        lat1,
        lon1,
        lat2,
        lon2) {

        const R =
            6371000;


        const φ1 =
            lat1 *
            Math.PI /
            180;


        const φ2 =
            lat2 *
            Math.PI /
            180;


        const Δφ =
            (lat2 - lat1) *
            Math.PI /
            180;


        const Δλ =
            (lon2 - lon1) *
            Math.PI /
            180;


        const a =

            Math.sin(
                Δφ / 2
            ) ** 2 +

            Math.cos(φ1) *
            Math.cos(φ2) *

            Math.sin(
                Δλ / 2
            ) ** 2;


        const c =
            2 *
            Math.atan2(
                Math.sqrt(a),
                Math.sqrt(1-a)
            );


        return R * c;
    }


    // =============================================================
    // TOKEN
    // =============================================================

    function obterToken() {

        return document
            .querySelector(
                '#antiForgeryForm input[name="__RequestVerificationToken"]'
            )
            .value;
    }


    // =============================================================
    // TOAST
    // =============================================================

    function mostrarToast(
        mensagem,
        sucesso) {

        const elemento =
            document.getElementById(
                "geoToast"
            );


        document
            .getElementById(
                "geoToastMessage"
            )
            .textContent =
                mensagem;


        elemento.classList.remove(
            "text-bg-success",
            "text-bg-danger"
        );


        elemento.classList.add(
            sucesso
                ? "text-bg-success"
                : "text-bg-danger"
        );


        bootstrap.Toast
            .getOrCreateInstance(
                elemento,
                {
                    delay:
                        3500
                }
            )
            .show();
    }


    // =============================================================
    // INICIALIZAÇÃO
    // =============================================================

    async function inicializarMapa() {

        carregarClientes();

        carregarLeads();

        atualizarKpis();


        const bounds =
            [];


        clientes.forEach(
            c =>
                bounds.push(
                    [
                        c.latitude,
                        c.longitude
                    ]
                )
        );


        leads.forEach(
            l =>
                bounds.push(
                    [
                        l.latitude,
                        l.longitude
                    ]
                )
        );


        if (
            bounds.length > 0
        ) {

            map.fitBounds(
                bounds,
                {
                    padding:
                        [30,30],

                    maxZoom:
                        13
                }
            );
        }
        else {

            map.setView(
                [
                    -22.9068,
                    -43.1729
                ],
                11
            );
        }


        setTimeout(
            () =>
                map.invalidateSize(),
            150
        );


        await inicializarGooglePlaces();
    }


    window.addEventListener(
        "resize",
        () =>
            map.invalidateSize()
    );


    inicializarMapa();

    </script>

}