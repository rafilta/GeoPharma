@page
@model GeoPharma.Pages.Mapas.IndexModel
@using System.Text.Json

@{
    ViewData["Title"] = "Central Comercial";

    var jsonOptions =
        new JsonSerializerOptions
        {
            PropertyNamingPolicy =
                JsonNamingPolicy.CamelCase
        };
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>

    html,
    body {
        overflow: hidden !important;
    }

    footer {
        display: none !important;
    }

    .geo-page {
        height: calc(100dvh - 55px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #f7f9fb;
    }

    .geo-header {
        background: white;
        padding: 10px 16px;
        border-bottom: 1px solid #e3e6ea;
        flex-shrink: 0;
    }

    .geo-title {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
    }

    .geo-kpis {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
        margin-top: 9px;
    }

    .geo-kpi {
        background: white;
        border: 1px solid #e0e4e8;
        border-radius: 8px;
        padding: 8px 10px;
    }

    .geo-kpi-number {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .geo-kpi-label {
        color: #6c757d;
        font-size: .65rem;
    }

    .geo-toolbar {
        background: white;
        padding: 8px 16px;
        border-bottom: 1px solid #dee2e6;
        flex-shrink: 0;
    }

    .geo-toolbar-grid {
        display: grid;
        grid-template-columns: minmax(400px, 1fr) 150px auto auto;
        gap: 8px;
        align-items: end;
    }

    .geo-field label {
        display: block;
        font-size: .66rem;
        color: #6c757d;
        margin-bottom: 3px;
        font-weight: 600;
    }

    .address-wrapper {
        position: relative;
    }

    .address-results {
        display: none;
        position: absolute;
        z-index: 5000;
        left: 0;
        right: 0;
        top: 100%;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 0 0 8px 8px;
        max-height: 260px;
        overflow-y: auto;
        box-shadow: 0 6px 20px rgba(0,0,0,.18);
    }

    .address-item {
        padding: 10px 12px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
        font-size: .78rem;
    }

        .address-item:hover {
            background: #f4f7fa;
        }

    .location-validation {
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 16px;
        border-bottom: 1px solid #dee2e6;
        background: #fff8e1;
        color: #664d03;
        font-size: .78rem;
    }

    .location-validation.active {
        display: flex;
    }

    .location-validation.verified {
        background: #e8f5ee;
        color: #0f5132;
    }

    .geo-map-container {
        flex: 1;
        min-height: 0;
        position: relative;
    }

    #map {
        width: 100%;
        height: 100%;
    }

    .map-loading {
        display: none;
        position: absolute;
        inset: 0;
        z-index: 4500;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.58);
        backdrop-filter: blur(1px);
    }

    .map-loading.active {
        display: flex;
    }

    .map-loading-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-radius: 10px;
        background: white;
        box-shadow: 0 5px 22px rgba(0,0,0,.22);
        color: #212529;
        font-weight: 600;
    }

    .geo-marker {
        width: 24px;
        height: 24px;
        position: relative;
        transform: rotate(-45deg);
        border-radius: 50% 50% 50% 0;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,.35);
    }

    .geo-marker-touch {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        touch-action: manipulation;
    }

    .geo-marker-inner {
        width: 8px;
        height: 8px;
        position: absolute;
        left: 6px;
        top: 6px;
        background: white;
        border-radius: 50%;
    }

    .geo-center-marker {
        width: 20px;
        height: 20px;
        background: #0d6efd;
        border-radius: 50%;
        border: 4px solid white;
        box-shadow: 0 0 0 4px rgba(13,110,253,.25);
    }

    .geo-legend {
        position: absolute;
        right: 12px;
        bottom: 12px;
        z-index: 800;
        background: rgba(255,255,255,.96);
        border-radius: 8px;
        padding: 9px 11px;
        box-shadow: 0 2px 12px rgba(0,0,0,.18);
    }

    .legend-row {
        font-size: .67rem;
        margin: 5px 0;
    }

    .legend-dot {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        margin-right: 6px;
    }

    .leaflet-popup-content {
        width: 320px !important;
    }

    .popup-company {
        font-weight: 700;
        font-size: .95rem;
    }

    .popup-type {
        font-size: .66rem;
        font-weight: 700;
        margin: 3px 0 9px;
        text-transform: uppercase;
    }

    .popup-row {
        padding: 5px 0;
        border-bottom: 1px solid #eee;
    }

    .popup-label {
        display: block;
        color: #6c757d;
        font-size: .62rem;
    }

    .popup-value {
        font-size: .76rem;
    }

    @@media(max-width: 767px) {

        html,
        body {
            overscroll-behavior: none;
        }

        .geo-page {
            height: calc(100dvh - 52px);
        }

        .geo-header {
            padding: 6px 8px;
        }

        .geo-title {
            font-size: .95rem;
        }

        .geo-kpis {
            display: flex;
            overflow-x: auto;
            gap: 5px;
            margin-top: 6px;
            padding-bottom: 2px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

        .geo-kpis::-webkit-scrollbar {
            display: none;
        }

        .geo-kpi {
            min-width: 88px;
            padding: 5px 8px;
        }

        .geo-kpi-number {
            font-size: .9rem;
        }

        .geo-toolbar {
            padding: 6px 8px;
        }

        .geo-toolbar-grid {
            grid-template-columns: 86px minmax(118px, 1fr) 84px;
            gap: 6px;
        }

        .address-field {
            grid-column: 1 / -1;
        }

        .radius-field {
            grid-column: 1;
        }

        .location-field {
            grid-column: 2;
        }

        .apply-field {
            grid-column: 3;
        }

        .location-field .btn,
        .apply-field .btn {
            padding-left: 6px;
            padding-right: 6px;
            font-size: .75rem;
            white-space: nowrap;
        }

        .address-results {
            max-height: min(42dvh, 300px);
        }

        .address-item {
            min-height: 46px;
            display: flex;
            align-items: center;
            font-size: .8rem;
        }

        .location-validation {
            align-items: stretch;
            flex-direction: column;
            gap: 7px;
            padding: 8px;
        }

        .location-validation .btn {
            width: 100%;
        }

        .leaflet-popup-content {
            width: min(255px, calc(100vw - 76px)) !important;
            margin: 12px 16px;
        }

        .leaflet-popup-content-wrapper {
            max-height: 58dvh;
            overflow-y: auto;
        }

        .geo-legend {
            right: 6px;
            bottom: 6px;
            padding: 5px 8px;
        }

        .legend-row {
            font-size: .6rem;
            margin: 3px 0;
        }

        .map-loading-card {
            max-width: calc(100vw - 32px);
            padding: 12px 15px;
            font-size: .82rem;
        }
    }
</style>

<div class="geo-page">

    <div class="geo-header">

        <h1 class="geo-title">
            <i class="fa-solid fa-map-location-dot text-primary me-1"></i>
            Central Comercial
        </h1>

        <div class="geo-kpis">

            <div class="geo-kpi">
                <div id="kpiPossiveis"
                     class="geo-kpi-number">0</div>
                <div class="geo-kpi-label">
                    Possíveis Leads
                </div>
            </div>

            <div class="geo-kpi">
                <div id="kpiLeads"
                     class="geo-kpi-number">
                    @Model.TotalLeads
                </div>
                <div class="geo-kpi-label">
                    Leads
                </div>
            </div>

            <div class="geo-kpi">
                <div id="kpiAndamento"
                     class="geo-kpi-number">
                    @Model.TotalEmAndamento
                </div>
                <div class="geo-kpi-label">
                    Em Andamento
                </div>
            </div>

            <div class="geo-kpi">
                <div id="kpiNegociando"
                     class="geo-kpi-number">
                    @Model.TotalNegociando
                </div>
                <div class="geo-kpi-label">
                    Negociando
                </div>
            </div>

            <div class="geo-kpi">
                <div class="geo-kpi-number">
                    @Model.TotalClientes
                </div>
                <div class="geo-kpi-label">
                    Clientes
                </div>
            </div>

        </div>

    </div>

    <div class="geo-toolbar">

        <div class="geo-toolbar-grid">

            <div class="geo-field address-field">

                <label>
                    Endereço
                </label>

                <div class="address-wrapper">

                    <div class="input-group">

                        <input id="addressInput"
                               type="text"
                               class="form-control"
                               placeholder="Rua, número, bairro, cidade e UF"
                               autocomplete="off"
                               aria-autocomplete="list"
                               aria-controls="addressResults" />

                        <button type="button"
                                id="btnBuscarEndereco"
                                class="btn btn-outline-secondary"
                                onclick="buscarEnderecos()">

                            <i class="fa-solid fa-magnifying-glass"></i>

                        </button>

                    </div>

                    <div id="addressResults"
                         class="address-results">
                    </div>

                </div>

            </div>

            <div class="geo-field radius-field">

                <label>
                    Raio
                </label>

                <div class="input-group">

                    <input id="radiusInput"
                           type="number"
                           class="form-control"
                           value="3"
                           min="1"
                           max="15" />

                    <span class="input-group-text">
                        km
                    </span>

                </div>

            </div>

            <div class="geo-field location-field">

                <label>&nbsp;</label>

                <button type="button"
                        id="btnLocation"
                        class="btn btn-outline-primary w-100"
                        onclick="usarLocalizacaoAtual()">

                    Minha localização

                </button>

            </div>

            <div class="geo-field apply-field">

                <label>&nbsp;</label>

                <button type="button"
                        id="btnApply"
                        class="btn btn-primary w-100"
                        onclick="aplicarPesquisa()">

                    Aplicar

                </button>

            </div>

        </div>

    </div>

    <div id="locationValidation"
         class="location-validation"
         role="status"
         aria-live="polite">

        <span id="locationValidationText"></span>

        <button type="button"
                id="btnConfirmLocation"
                class="btn btn-warning btn-sm flex-shrink-0"
                onclick="confirmarPontoMapa()">
            Confirmar ponto no mapa
        </button>

    </div>

    <div class="geo-map-container">

        <div id="map"></div>

        <div id="mapLoading"
             class="map-loading"
             role="status"
             aria-live="polite"
             aria-hidden="true">

            <div class="map-loading-card">
                <span class="spinner-border text-primary"
                      aria-hidden="true"></span>
                <span>Buscando farmácias na região...</span>
            </div>

        </div>

        <div class="geo-legend">

            <div class="legend-row">
                <span class="legend-dot"
                      style="background:#198754"></span>
                Cliente
            </div>

            <div class="legend-row">
                <span class="legend-dot"
                      style="background:#dc3545"></span>
                Possível Lead
            </div>

            <div class="legend-row">
                <span class="legend-dot"
                      style="background:#ffc107"></span>
                Lead Capturado
            </div>

        </div>

    </div>

</div>

<form id="antiForgeryForm"
      method="post"
      style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    <script>

    const clientes =
        @Html.Raw(
            JsonSerializer.Serialize(
                Model.ClientesMapa,
                jsonOptions));

    const leads =
        @Html.Raw(
            JsonSerializer.Serialize(
                Model.LeadsMapa,
                jsonOptions));

    let possiveisLeads = [];

    let selectedLatitude = null;
    let selectedLongitude = null;
    let selectedCidade = null;
    let selectedUf = null;
    let selectedAddress = null;
    let locationConfirmed = false;
    let locationNeedsConfirmation = false;
    let autocompleteTimer = null;
    let addressRequestId = 0;

    const map =
        L.map("map");

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution: "© OpenStreetMap"
        }
    ).addTo(map);

    const clientesLayer =
        L.layerGroup().addTo(map);

    const leadsLayer =
        L.layerGroup().addTo(map);

    const possiveisLayer =
        L.layerGroup().addTo(map);

    let raioCircle = null;
    let centroMarker = null;

    function criarIcone(cor) {

        return L.divIcon({

            className: "geo-marker-touch",

            html:
                `<div class="geo-marker"
                      style="background:${cor}">
                    <div class="geo-marker-inner"></div>
                 </div>`,

            iconSize: [44,44],
            iconAnchor: [22,38],
            popupAnchor: [0,-34]
        });
    }

    function escapeHtml(valor) {

        return String(valor ?? "")
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;");
    }

    function urlMaps(lat, lon) {

        return "https://www.google.com/maps/dir/?api=1&destination=" +
            encodeURIComponent(`${lat},${lon}`);
    }

    function carregarClientes() {

        clientesLayer.clearLayers();

        clientes.forEach(c => {

            const marker =
                L.marker(
                    [c.latitude, c.longitude],
                    {
                        icon:
                            criarIcone("#198754"),
                        zIndexOffset: 3000
                    });

            marker.bindPopup(`

                <div class="popup-company">
                    ${escapeHtml(c.nome)}
                </div>

                <div class="popup-type text-success">
                    Cliente
                </div>

                <div class="popup-row">
                    <span class="popup-label">CNPJ</span>
                    <span class="popup-value">
                        ${escapeHtml(c.cnpj)}
                    </span>
                </div>

                <div class="popup-row">
                    <span class="popup-label">Endereço</span>
                    <span class="popup-value">
                        ${escapeHtml(c.endereco)}
                    </span>
                </div>

                <div class="d-grid mt-2">

                    <a href="${urlMaps(c.latitude,c.longitude)}"
                       target="_blank"
                       class="btn btn-outline-primary btn-sm">

                        Abrir no Maps

                    </a>

                </div>
            `);

            marker.addTo(clientesLayer);
        });
    }

    function carregarLeads() {

        leadsLayer.clearLayers();

        leads.forEach(l => {

            const marker =
                L.marker(
                    [l.latitude,l.longitude],
                    {
                        icon:
                            criarIcone("#ffc107"),
                        zIndexOffset: 2000
                    });

            marker.bindPopup(`

                <div class="popup-company">
                    ${escapeHtml(l.nome)}
                </div>

                <div class="popup-type text-warning">
                    Lead Capturado
                </div>

                <div class="popup-row">
                    <span class="popup-label">CNPJ</span>
                    <span class="popup-value">
                        ${escapeHtml(l.cnpj)}
                    </span>
                </div>

                <div class="popup-row">
                    <span class="popup-label">
                        Responsável
                    </span>
                    <span class="popup-value">
                        ${escapeHtml(l.responsavel)}
                    </span>
                </div>

                <div class="d-grid mt-2">

                    <a href="${urlMaps(l.latitude,l.longitude)}"
                       target="_blank"
                       class="btn btn-outline-primary btn-sm">

                        Abrir no Maps

                    </a>

                </div>
            `);

            marker.addTo(leadsLayer);
        });
    }

    function carregarPossiveis() {

        possiveisLayer.clearLayers();

        possiveisLeads.forEach(
            (p,index) => {

                const marker =
                    L.marker(
                        [p.latitude,p.longitude],
                        {
                            icon:
                                criarIcone("#dc3545"),
                            zIndexOffset: 5000,
                            riseOnHover: true,
                            keyboard: true,
                            bubblingMouseEvents: false
                        });

                marker.bindPopup(`

                    <div class="popup-company">
                        ${escapeHtml(p.nomeFantasia)}
                    </div>

                    <div class="popup-type text-danger">
                        Possível Lead
                    </div>

                    <div class="popup-row">
                        <span class="popup-label">
                            Razão Social
                        </span>
                        <span class="popup-value">
                            ${escapeHtml(p.razaoSocial)}
                        </span>
                    </div>

                    <div class="popup-row">
                        <span class="popup-label">
                            CNPJ
                        </span>
                        <span class="popup-value fw-bold">
                            ${p.cadastroCompleto
                                ? escapeHtml(p.cnpj)
                                : "Ainda não identificado"}
                        </span>
                    </div>

                    <div class="popup-row">
                        <span class="popup-label">
                            Endereço
                        </span>
                        <span class="popup-value">
                            ${escapeHtml(p.endereco)}
                        </span>
                    </div>

                    <div class="popup-row">
                        <span class="popup-label">
                            Confiança
                        </span>
                        <span class="popup-value">
                            ${p.cadastroCompleto
                                ? `${p.confianca}%`
                                : "Ponto confirmado no mapa"}
                        </span>
                    </div>

                    <div class="d-grid gap-2 mt-2">

                        <a href="${urlMaps(p.latitude,p.longitude)}"
                           target="_blank"
                           class="btn btn-outline-primary btn-sm">

                            Abrir no Maps

                        </a>

                        ${p.cadastroCompleto ? `
                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    onclick="capturarLead(${index})">
                                Capturar Lead
                            </button>
                        ` : `
                            <div class="small text-muted text-center">
                                O CNPJ precisa ser confirmado antes da captura.
                            </div>
                        `}

                    </div>
                `);

                marker.addTo(possiveisLayer);
            });
    }

    function limparEnderecoSelecionado() {

        selectedLatitude = null;
        selectedLongitude = null;
        selectedCidade = null;
        selectedUf = null;
        selectedAddress = null;
        locationConfirmed = false;
        locationNeedsConfirmation = false;

        const validacao =
            document.getElementById("locationValidation");

        validacao.classList.remove("active", "verified");
    }

    function selecionarEndereco(item) {

        const textoDigitado =
            document
                .getElementById("addressInput")
                .value;

        const numeroSolicitado =
            textoDigitado.match(/\b\d{1,6}[A-Za-z]?\b/)?.[0] ?? "";

        const numeroConfirmado =
            !numeroSolicitado ||
            new RegExp(
                `(?:^|,|\\s)${numeroSolicitado}(?:,|\\s|$)`,
                "i")
                .test(item.endereco);

        selectedLatitude = item.latitude;
        selectedLongitude = item.longitude;
        selectedCidade = item.cidade;
        selectedUf = item.uf;
        selectedAddress = item.endereco;
        locationNeedsConfirmation =
            !numeroConfirmado;
        locationConfirmed =
            numeroConfirmado;

        document
            .getElementById("addressInput")
            .value = item.endereco;

        document
            .getElementById("addressResults")
            .style.display = "none";
    }

    function solicitarConfirmacaoNoMapa(raio) {

        const validacao =
            document.getElementById("locationValidation");

        const texto =
            document.getElementById("locationValidationText");

        const botao =
            document.getElementById("btnConfirmLocation");

        texto.innerHTML =
            `<strong>Número não confirmado pela base gratuita.</strong> ` +
            `Arraste o marcador azul para o ponto correto e confirme antes da busca.`;

        botao.style.display = "inline-block";
        validacao.classList.remove("verified");
        validacao.classList.add("active");

        desenharRaio(raio, true);
    }

    function confirmarPontoMapa() {

        if (!centroMarker) return;

        const ponto = centroMarker.getLatLng();

        selectedLatitude = ponto.lat;
        selectedLongitude = ponto.lng;
        locationConfirmed = true;
        locationNeedsConfirmation = false;

        if (centroMarker.dragging) {
            centroMarker.dragging.disable();
        }

        const validacao =
            document.getElementById("locationValidation");

        document
            .getElementById("locationValidationText")
            .innerHTML =
                `<strong>Localização confirmada manualmente.</strong> ` +
                `A pesquisa usará exatamente o ponto selecionado no mapa.`;

        document
            .getElementById("btnConfirmLocation")
            .style.display = "none";

        validacao.classList.add("active", "verified");

        aplicarPesquisa();
    }

    async function buscarEnderecos(
        selecionarPrimeiro = false,
        silencioso = false) {

        const termo =
            document
                .getElementById("addressInput")
                .value
                .trim();

        if (!termo) {
            return false;
        }

        const requestId = ++addressRequestId;

        const botao =
            document.getElementById(
                "btnBuscarEndereco");

        const painel =
            document.getElementById(
                "addressResults");

        if (!silencioso) {
            painel.innerHTML =
                `<div class="address-item text-muted">
                    Buscando endereços...
                 </div>`;
            painel.style.display = "block";
        }

        botao.disabled = true;

        try {

            const response =
                await fetch(
                    "?handler=BuscarEnderecos&termo=" +
                    encodeURIComponent(termo));

            const result =
                await response.json();

            if (requestId !== addressRequestId) {
                return false;
            }

            painel.innerHTML = "";

            if (!result.success ||
                !result.data?.length) {

                painel.innerHTML =
                    `<div class="address-item">
                        Nenhum endereço encontrado.
                     </div>`;

                painel.style.display = "block";

                return false;
            }

            if (selecionarPrimeiro) {
                selecionarEndereco(result.data[0]);
                return true;
            }

            result.data.forEach(item => {

                const div =
                    document.createElement("div");

                div.className = "address-item";
                div.setAttribute("role", "option");
                div.textContent = item.endereco;

                div.onclick = function() {
                    selecionarEndereco(item);
                };

                painel.appendChild(div);
            });

            painel.style.display = "block";
            return true;
        }
        catch {

            if (requestId === addressRequestId) {
                painel.innerHTML =
                    `<div class="address-item text-danger">
                        Não foi possível consultar os endereços.
                     </div>`;
                painel.style.display = "block";
            }

            return false;
        }
        finally {
            if (requestId === addressRequestId) {
                botao.disabled = false;
            }
        }
    }

    async function aplicarPesquisa() {

        if (selectedLatitude === null) {

            const encontrou =
                await buscarEnderecos(true, true);

            if (!encontrou) {
                return;
            }
        }

        let raio =
            parseFloat(
                document
                    .getElementById(
                        "radiusInput")
                    .value);

        if (!raio || raio < 1)
            raio = 1;

        if (raio > 15)
            raio = 15;

        if (locationNeedsConfirmation &&
            !locationConfirmed) {

            solicitarConfirmacaoNoMapa(raio);
            return;
        }

        desenharRaio(raio);

        const button =
            document.getElementById(
                "btnApply");

        const original =
            button.innerHTML;

        button.disabled = true;
        button.innerHTML =
            `<span class="spinner-border spinner-border-sm me-1"
                   aria-hidden="true"></span>
             Buscando...`;

        const loading =
            document.getElementById("mapLoading");

        loading.classList.add("active");
        loading.setAttribute("aria-hidden", "false");

        try {

            const url =
                "?handler=Possiveis" +
                "&latitude=" +
                encodeURIComponent(
                    selectedLatitude) +
                "&longitude=" +
                encodeURIComponent(
                    selectedLongitude) +
                "&raioKm=" +
                encodeURIComponent(raio) +
                "&cidade=" +
                encodeURIComponent(
                    selectedCidade) +
                "&uf=" +
                encodeURIComponent(
                    selectedUf);

            const response =
                await fetch(url);

            const result =
                await response.json();

            if (!result.success) {

                alert(result.message);

                return;
            }

            possiveisLeads =
                result.data ?? [];

            carregarPossiveis();

            atualizarKpis();

        }
        finally {

            button.disabled = false;
            button.innerHTML = original;

            loading.classList.remove("active");
            loading.setAttribute("aria-hidden", "true");
        }
    }

    function obterLocalizacaoComMelhorPrecisao() {

        return new Promise((resolve, reject) => {

            let melhorPosicao = null;
            let finalizado = false;

            const concluir = () => {

                if (finalizado) return;
                finalizado = true;

                navigator.geolocation
                    .clearWatch(watchId);

                clearTimeout(timeoutId);

                if (melhorPosicao &&
                    melhorPosicao.coords.accuracy <= 1000) {

                    resolve(melhorPosicao);
                    return;
                }

                reject({
                    baixaPrecisao: true,
                    accuracy:
                        melhorPosicao?.coords.accuracy
                });
            };

            const watchId =
                navigator.geolocation.watchPosition(
                    position => {

                        if (!melhorPosicao ||
                            position.coords.accuracy <
                            melhorPosicao.coords.accuracy) {

                            melhorPosicao = position;
                        }

                        if (position.coords.accuracy <= 200) {
                            concluir();
                        }
                    },
                    error => {

                        if (finalizado) return;
                        finalizado = true;
                        clearTimeout(timeoutId);
                        navigator.geolocation
                            .clearWatch(watchId);
                        reject(error);
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 15000,
                        maximumAge: 0
                    });

            const timeoutId =
                setTimeout(concluir, 12000);
        });
    }

    async function usarLocalizacaoAtual() {

        const botao =
            document.getElementById("btnLocation");

        const textoOriginal = botao.innerHTML;

        botao.disabled = true;
        botao.innerHTML =
            `<span class="spinner-border spinner-border-sm me-1"
                   aria-hidden="true"></span>
             Localizando...`;

        try {

            const position =
                await obterLocalizacaoComMelhorPrecisao();

            selectedLatitude =
                position.coords.latitude;

            selectedLongitude =
                position.coords.longitude;

            const response =
                await fetch(
                    "?handler=Contexto" +
                    "&latitude=" +
                    selectedLatitude +
                    "&longitude=" +
                    selectedLongitude);

            const result =
                await response.json();

            if (!result.success) {

                alert(result.message);
                return;
            }

            selectedCidade =
                result.data.cidade;

            selectedUf =
                result.data.uf;

            selectedAddress =
                result.data.endereco;

            locationConfirmed = true;
            locationNeedsConfirmation = false;

            document
                .getElementById("addressInput")
                .value =
                    selectedAddress ||
                    `${selectedCidade} - ${selectedUf}`;

            document
                .getElementById("addressResults")
                .style.display = "none";

            map.setView(
                [
                    selectedLatitude,
                    selectedLongitude
                ],
                16);
        }
        catch (error) {

            if (error?.baixaPrecisao) {

                const metros = error.accuracy
                    ? Math.round(error.accuracy)
                    : null;

                alert(
                    "O computador forneceu uma localização" +
                    (metros ? ` com precisão de apenas ±${metros} metros.` : " sem precisão suficiente.") +
                    " Para evitar um endereço incorreto, o campo não foi alterado. " +
                    "Ative a localização precisa do Windows/Chrome ou digite o endereço e selecione uma sugestão.");
            }
            else {

                alert(
                    "Não foi possível obter sua localização precisa.");
            }
        }
        finally {

            botao.disabled = false;
            botao.innerHTML = textoOriginal;
        }
    }

    function desenharRaio(
        raioKm,
        permitirAjuste = false) {

        if (raioCircle)
            map.removeLayer(raioCircle);

        if (centroMarker)
            map.removeLayer(centroMarker);

        raioCircle =
            L.circle(
                [
                    selectedLatitude,
                    selectedLongitude
                ],
                {
                    radius:
                        raioKm * 1000,
                    color: "#0d6efd",
                    fillOpacity: .05
                })
                .addTo(map);

        centroMarker =
            L.marker(
                [
                    selectedLatitude,
                    selectedLongitude
                ],
                {
                    draggable: permitirAjuste,
                    title: permitirAjuste
                        ? "Arraste para ajustar o ponto"
                        : "Centro da pesquisa"
                })
                .addTo(map);

        if (permitirAjuste) {

            centroMarker.on("drag", event => {

                const ponto =
                    event.target.getLatLng();

                selectedLatitude = ponto.lat;
                selectedLongitude = ponto.lng;
                raioCircle.setLatLng(ponto);
            });

            centroMarker.bindTooltip(
                "Arraste para o local correto",
                {
                    permanent: true,
                    direction: "top"
                });
        }

        map.fitBounds(
            raioCircle.getBounds());
    }

    async function capturarLead(index) {

        const p =
            possiveisLeads[index];

        const response =
            await fetch(
                "?handler=CapturarLead",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json",

                        "RequestVerificationToken":
                            obterToken()
                    },

                    body:
                        JSON.stringify({
                            cnpj: p.cnpj,
                            razaoSocial:
                                p.razaoSocial,
                            nomeFantasia:
                                p.nomeFantasia,
                            endereco:
                                p.endereco,
                            latitude:
                                p.latitude,
                            longitude:
                                p.longitude
                        })
                });

        const result =
            await response.json();

        if (!result.success) {

            alert(result.message);
            return;
        }

        leads.push(
            result.lead);

        possiveisLeads.splice(
            index,
            1);

        carregarLeads();
        carregarPossiveis();
        atualizarKpis();

        map.closePopup();
    }

    function atualizarKpis() {

        document
            .getElementById(
                "kpiPossiveis")
            .textContent =
                possiveisLeads.length;

        document
            .getElementById(
                "kpiLeads")
            .textContent =
                leads.length;

        document
            .getElementById(
                "kpiAndamento")
            .textContent =
                leads.filter(x =>
                    x.status ===
                    "Em Andamento")
                    .length;

        document
            .getElementById(
                "kpiNegociando")
            .textContent =
                leads.filter(x =>
                    x.status ===
                    "Negociando")
                    .length;
    }

    function obterToken() {

        return document
            .querySelector(
                '#antiForgeryForm input[name="__RequestVerificationToken"]')
            .value;
    }

    function inicializar() {

        carregarClientes();
        carregarLeads();
        atualizarKpis();

        const bounds = [];

        clientes.forEach(c =>
            bounds.push(
                [
                    c.latitude,
                    c.longitude
                ]));

        if (bounds.length) {

            map.fitBounds(
                bounds,
                {
                    padding: [30,30],
                    maxZoom: 12
                });
        }
        else {

            map.setView(
                [
                    -22.9068,
                    -43.1729
                ],
                11);
        }
    }

    const addressInput =
        document.getElementById("addressInput");

    const addressResults =
        document.getElementById("addressResults");

    addressInput.addEventListener("input", function() {

        limparEnderecoSelecionado();
        addressRequestId++;

        clearTimeout(autocompleteTimer);

        const termo = this.value.trim();

        if (termo.length < 3) {
            addressResults.innerHTML = "";
            addressResults.style.display = "none";
            return;
        }

        autocompleteTimer = setTimeout(
            () => buscarEnderecos(false, true),
            450);
    });

    addressInput.addEventListener("keydown", function(event) {

        if (event.key === "Enter") {
            event.preventDefault();
            clearTimeout(autocompleteTimer);
            aplicarPesquisa();
        }

        if (event.key === "Escape") {
            addressResults.style.display = "none";
        }
    });

    document.addEventListener("click", function(event) {

        if (!event.target.closest(".address-wrapper")) {
            addressResults.style.display = "none";
        }
    });

    inicializar();

    </script>

}
