                                    ),

                                zIndexOffset:
                                    1000
                            }
                        );


                    const cnpj =
                        farmacia.cnpj

                            ? formatarCnpj(
                                farmacia.cnpj
                            )

                            : "Não informado";


                    const razaoSocial =
                        farmacia.razaoSocial ||
