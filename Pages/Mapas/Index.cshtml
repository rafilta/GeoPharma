@page
@model GeoPharma.Pages.Mapas.IndexModel
@using System.Text.Json

@{
    ViewData["Title"] = "Central Comercial";

    var jsonOptions =
        new JsonSerializerOptions
        {
            PropertyNamingPolicy =
                JsonNamingPolicy.CamelCase
        };
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>

    html,
    body {
        overflow: hidden !important;
    }

    footer {
        display: none !important;
    }

    .geo-page {
        height: calc(100vh - 54px);
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #f7f9fb;
    }

    /* =========================================================
       CABEÇALHO
       ========================================================= */

    .geo-header {
        background: #fff;
        padding: 12px 16px;
        border-bottom: 1px solid #e6e9ed;
        flex-shrink: 0;
    }

    .geo-title {
        margin: 0;
        font-size: 1.22rem;
        font-weight: 700;
    }

    .geo-subtitle {
        color: #6c757d;
        margin: 2px 0 0;
        font-size: .74rem;
    }

    /* =========================================================
       KPIS
       ========================================================= */

    .geo-kpis {
        margin-top: 10px;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
    }

    .geo-kpi {
        background: white;
        border: 1px solid #e1e5e9;
        border-radius: 8px;
        padding: 9px 11px;
    }

    .geo-kpi-number {
        font-size: 1.15rem;
        font-weight: 700;
    }

    .geo-kpi-label {
        margin-top: 2px;
        color: #6c757d;
        font-size: .68rem;
    }

    /* =========================================================
       PESQUISA
       ========================================================= */

    .geo-toolbar {
        background: white;
        border-bottom: 1px solid #dee2e6;
        padding: 8px 16px;
        flex-shrink: 0;
    }

    .geo-toolbar-grid {
        display: grid;
        grid-template-columns: minmax(400px, 3fr) 140px auto auto;
        gap: 8px;
        align-items: end;
    }

    .geo-field label {
        display: block;
        color: #6c757d;
        font-size: .68rem;
        font-weight: 600;
        margin-bottom: 3px;
    }

    /* =========================================================
       GOOGLE PLACES
       ========================================================= */

    #googleAutocomplete {
        width: 100%;
    }

    gmp-place-autocomplete {
        width: 100%;
        display: block;
    }

    .google-not-configured {
        border: 1px solid #dc3545;
        background: #fff5f5;
        color: #842029;
        border-radius: 6px;
        padding: 8px 10px;
        font-size: .76rem;
    }

    /* =========================================================
       MAPA
       ========================================================= */

    .geo-map-container {
        position: relative;
        flex: 1;
        min-height: 0;
    }

    #map {
        width: 100%;
        height: 100%;
    }

    /* =========================================================
       LEGENDA
       ========================================================= */

    .geo-legend {
        position: absolute;
        right: 15px;
        bottom: 18px;
        z-index: 800;
        background: rgba(255,255,255,.96);
        border-radius: 9px;
        padding: 11px 13px;
        box-shadow: 0 2px 12px rgba(0,0,0,.18);
        min-width: 180px;
    }

    .legend-title {
        font-size: .76rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 5px 0;
        font-size: .70rem;
    }

    .legend-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        flex-shrink: 0;
        border: 2px solid white;
        box-shadow: 0 0 0 1px rgba(0,0,0,.18);
    }

    /* =========================================================
       MARCADORES
       ========================================================= */

    .geo-marker {
        width: 23px;
        height: 23px;
        position: relative;
        transform: rotate(-45deg);
        border-radius: 50% 50% 50% 0;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,.35);
    }

    .geo-marker-inner {
        position: absolute;
        width: 7px;
        height: 7px;
        left: 6px;
        top: 6px;
        border-radius: 50%;
        background: white;
    }

    .current-location-marker {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #0d6efd;
        border: 4px solid white;
        box-shadow: 0 0 0 5px rgba(13,110,253,.20);
    }

    /* =========================================================
       GPS
       ========================================================= */

    .gps-status {
        position: absolute;
        left: 12px;
        bottom: 15px;
        z-index: 850;
        display: none;
        background: rgba(255,255,255,.97);
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0,0,0,.18);
        padding: 9px 11px;
        font-size: .72rem;
        max-width: 260px;
    }

    .gps-accuracy-good {
        color: #198754;
        font-weight: 700;
    }

    .gps-accuracy-medium {
        color: #b58100;
        font-weight: 700;
    }

    .gps-accuracy-bad {
        color: #dc3545;
        font-weight: 700;
    }

    /* =========================================================
       POPUP
       ========================================================= */

    .leaflet-popup-content-wrapper {
        border-radius: 9px;
    }

    .leaflet-popup-content {
        margin: 14px;
        width: 320px !important;
    }

    .popup-company {
        font-size: .96rem;
        font-weight: 700;
    }

    .popup-type {
        margin: 3px 0 10px;
        font-size: .67rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .popup-row {
        padding: 5px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .popup-label {
        display: block;
        color: #6c757d;
        font-size: .64rem;
    }

    .popup-value {
        display: block;
        font-size: .78rem;
        font-weight: 500;
    }

    .popup-actions {
        margin-top: 10px;
    }

    /* =========================================================
       TOAST
       ========================================================= */

    .geo-toast-container {
        position: fixed;
        top: 70px;
        right: 20px;
        width: 350px;
        z-index: 10000;
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @@media(max-width: 767px) {

        .geo-page {
            height: calc(100dvh - 55px);
        }

        .geo-header {
            padding: 8px 10px;
        }

        .geo-title {
            font-size: 1.05rem;
        }

        .geo-subtitle {
            display: none;
        }

        .geo-kpis {
            display: flex;
            overflow-x: auto;
            gap: 6px;
            margin-top: 7px;
            padding-bottom: 2px;
            scrollbar-width: none;
        }

            .geo-kpis::-webkit-scrollbar {
                display: none;
            }

        .geo-kpi {
            flex: 0 0 112px;
            min-width: 112px;
            padding: 7px 9px;
        }

        .geo-kpi-number {
            font-size: 1rem;
        }

        .geo-kpi-label {
            font-size: .62rem;
        }

        .geo-toolbar {
            padding: 7px 9px;
        }

        .geo-toolbar-grid {
            display: grid;
            grid-template-columns: 1fr 90px;
            gap: 6px;
        }

        .geo-address-field {
            grid-column: 1 / -1;
        }

        .geo-current-location {
            grid-column: 1 / 2;
        }

        .geo-apply {
            grid-column: 2 / 3;
        }

        .geo-field label {
            font-size: .62rem;
        }

        .geo-toolbar .btn {
            font-size: .75rem;
            min-height: 40px;
        }

        .geo-toolbar .form-control,
        .geo-toolbar .input-group-text {
            min-height: 40px;
        }

        .geo-legend {
            right: 8px;
            bottom: 8px;
            min-width: 150px;
            padding: 8px 10px;
        }

        .legend-title {
            font-size: .68rem;
        }

        .legend-row {
            font-size: .62rem;
            margin: 4px 0;
        }

        .gps-status {
            left: 8px;
            bottom: 8px;
            max-width: 190px;
            font-size: .64rem;
        }

        .leaflet-popup-content {
            width: 260px !important;
            margin: 11px;
        }

        .popup-actions .btn {
            min-height: 42px;
            font-size: .78rem;
        }
    }
</style>


<div class="geo-page">

    <!-- CABEÇALHO -->

    <div class="geo-header">

        <h1 class="geo-title">

            <i class="fa-solid fa-map-location-dot text-primary me-1"></i>

            Central Comercial

        </h1>

        <p class="geo-subtitle">

            Clientes, leads capturados e oportunidades comerciais.

        </p>


        <div class="geo-kpis">

            <div class="geo-kpi">

                <div class="geo-kpi-number"
                     id="kpiPossiveis">
                    0
                </div>

                <div class="geo-kpi-label">
                    Possíveis Leads
                </div>

            </div>

            <div class="geo-kpi">

                <div class="geo-kpi-number"
                     id="kpiLeads">

                    @Model.TotalLeads

                </div>

                <div class="geo-kpi-label">
                    Leads Cadastrados
                </div>

            </div>

            <div class="geo-kpi">

                <div class="geo-kpi-number"
                     id="kpiAndamento">

                    @Model.TotalEmAndamento

                </div>

                <div class="geo-kpi-label">
                    Em Andamento
                </div>

            </div>

            <div class="geo-kpi">

                <div class="geo-kpi-number"
                     id="kpiNegociando">

                    @Model.TotalNegociando

                </div>

                <div class="geo-kpi-label">
                    Negociando
                </div>

            </div>

            <div class="geo-kpi">

                <div class="geo-kpi-number">

                    @Model.TotalClientes

                </div>

                <div class="geo-kpi-label">
                    Clientes
                </div>

            </div>

        </div>

    </div>


    <!-- PESQUISA -->

    <div class="geo-toolbar">

        <div class="geo-toolbar-grid">


            <div class="geo-field geo-address-field">

                <label>
                    Endereço
                </label>

                @if (!string.IsNullOrWhiteSpace(
                   Model.GoogleMapsApiKey))
                {
                    <div id="googleAutocomplete">
                    </div>
                }
                else
                {
                    <div class="google-not-configured">

                        Configure GoogleMaps:ApiKey para habilitar
                        busca precisa de endereço.

                    </div>
                }

            </div>


            <div class="geo-field">

                <label>
                    Raio
                </label>

                <div class="input-group">

                    <input type="number"
                           id="radiusInput"
                           class="form-control"
                           value="3"
                           min="1"
                           max="30" />

                    <span class="input-group-text">
                        km
                    </span>

                </div>

            </div>


            <div class="geo-field geo-current-location">

                <label>&nbsp;</label>

                <button type="button"
                        id="btnCurrentLocation"
                        class="btn btn-outline-primary w-100"
                        onclick="usarLocalizacaoAtual()">

                    <i class="fa-solid fa-location-crosshairs me-1"></i>

                    Minha localização

                </button>

            </div>


            <div class="geo-field geo-apply">

                <label>&nbsp;</label>

                <button type="button"
                        id="btnAplicar"
                        class="btn btn-primary w-100"
                        onclick="aplicarPesquisa()">

                    <i class="fa-solid fa-crosshairs me-1"></i>

                    Aplicar

                </button>

            </div>

        </div>

    </div>


    <!-- MAPA -->

    <div class="geo-map-container">

        <div id="map"></div>


        <div id="gpsStatus"
             class="gps-status">
        </div>


        <div class="geo-legend">

            <div class="legend-title">

                Situação Comercial

            </div>

            <div class="legend-row">

                <span class="legend-dot"
                      style="background:#198754">
                </span>

                Cliente

            </div>

            <div class="legend-row">

                <span class="legend-dot"
                      style="background:#dc3545">
                </span>

                Possível Lead

            </div>

            <div class="legend-row">

                <span class="legend-dot"
                      style="background:#ffc107">
                </span>

                Lead Capturado

            </div>

        </div>

    </div>

</div>


<form id="antiForgeryForm"
      method="post"
      style="display:none">

    @Html.AntiForgeryToken()

</form>


<div class="geo-toast-container">

    <div id="geoToast"
         class="toast align-items-center border-0">

        <div class="d-flex">

            <div id="geoToastMessage"
                 class="toast-body">
            </div>

            <button type="button"
                    class="btn-close me-2 m-auto"
                    data-bs-dismiss="toast">
            </button>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    @if (!string.IsNullOrWhiteSpace(
       Model.GoogleMapsApiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&v=weekly&libraries=places">
        </script>
    }

    <script>

    // =============================================================
    // DADOS
    // =============================================================

    const clientes =
        @Html.Raw(
            JsonSerializer.Serialize(
                Model.ClientesMapa,
                jsonOptions
            )
        );

    const leads =
        @Html.Raw(
            JsonSerializer.Serialize(
                Model.LeadsMapa,
                jsonOptions
            )
        );

    let farmaciasEncontradas =
        [];

    let selectedLatitude =
        null;

    let selectedLongitude =
        null;

    let selectedAddress =
        null;

    let selectedAccuracy =
        null;

    let localizacaoVemDoGps =
        false;


    // =============================================================
    // MAPA
    // =============================================================

    const map =
        L.map(
            "map",
            {
                zoomControl: true
            }
        );

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,

            attribution:
                "© OpenStreetMap"
        }
    ).addTo(map);


    const clientesLayer =
        L.layerGroup().addTo(map);

    const leadsLayer =
        L.layerGroup().addTo(map);

    const oportunidadesLayer =
        L.layerGroup().addTo(map);


    let raioCircle =
        null;

    let centroMarker =
        null;

    let precisaoCircle =
        null;


    // =============================================================
    // GOOGLE PLACES AUTOCOMPLETE
    // =============================================================

    async function inicializarGooglePlaces() {

        if (
            typeof google === "undefined" ||
            !google.maps
        ) {
            return;
        }

        try {

            const {
                PlaceAutocompleteElement
            } =
                await google.maps.importLibrary(
                    "places"
                );


            const host =
                document.getElementById(
                    "googleAutocomplete"
                );


            if (!host) {
                return;
            }


            const autocomplete =
                new PlaceAutocompleteElement({
                    includedRegionCodes:
                        ["br"]
                });


            autocomplete.placeholder =
                "Digite rua, número, bairro ou cidade";


            autocomplete.style.width =
                "100%";


            host.innerHTML =
                "";


            host.appendChild(
                autocomplete
            );


            autocomplete.addEventListener(
                "gmp-select",
                async event => {

                    try {

                        const place =
                            event
                                .placePrediction
                                .toPlace();


                        await place.fetchFields({
                            fields:
                            [
                                "displayName",
                                "formattedAddress",
                                "location"
                            ]
                        });


                        if (!place.location) {

                            mostrarToast(
                                "O Google não retornou coordenadas para este endereço.",
                                false
                            );

                            return;
                        }


                        selectedLatitude =
                            place.location.lat();


                        selectedLongitude =
                            place.location.lng();


                        selectedAddress =
                            place.formattedAddress ||
                            place.displayName ||
                            "Endereço selecionado";


                        selectedAccuracy =
                            null;


                        localizacaoVemDoGps =
                            false;


                        mostrarToast(
                            "Endereço validado pelo Google. Clique em Aplicar.",
                            true
                        );

                    }
                    catch(error) {

                        console.error(
                            error
                        );


                        mostrarToast(
                            "Não foi possível validar este endereço.",
                            false
                        );
                    }
                }
            );

        }
        catch(error) {

            console.error(
                "Erro ao inicializar Google Places:",
                error
            );
        }
    }


    // =============================================================
    // ÍCONES
    // =============================================================

    function criarIcone(
        cor) {

        return L.divIcon({

            className:
                "",

            html: `

                <div class="geo-marker"
                     style="background:${cor}">

                    <div class="geo-marker-inner">
                    </div>

                </div>
            `,

            iconSize:
                [25,25],

            iconAnchor:
                [12,25],

            popupAnchor:
                [0,-24]
        });
    }


    // =============================================================
    // HTML
    // =============================================================

    function escapeHtml(
        value) {

        if (
            value === null ||
            value === undefined
        ) {
            return "";
        }

        return String(value)

            .replaceAll(
                "&",
                "&amp;"
            )

            .replaceAll(
                "<",
                "&lt;"
            )

            .replaceAll(
                ">",
                "&gt;"
            )

            .replaceAll(
                '"',
                "&quot;"
            )

            .replaceAll(
                "'",
                "&#039;"
            );
    }


    // =============================================================
    // GOOGLE MAPS ROTA
    // =============================================================

    function criarUrlMaps(
        latitude,
        longitude) {

        return (

            "https://www.google.com/maps/dir/?api=1" +

            "&destination=" +

            encodeURIComponent(
                `${latitude},${longitude}`
            )
        );
    }


    // =============================================================
    // CLIENTES VERDES
    // =============================================================

    function carregarClientes() {

        clientesLayer
            .clearLayers();


        clientes.forEach(
            cliente => {

                const marker =
                    L.marker(
                        [
                            cliente.latitude,
                            cliente.longitude
                        ],
                        {
                            icon:
                                criarIcone(
                                    "#198754"
                                ),

                            zIndexOffset:
                                3000
                        }
                    );


                const mapsUrl =
                    criarUrlMaps(
                        cliente.latitude,
                        cliente.longitude
                    );


                marker.bindPopup(`

                    <div>

                        <div class="popup-company">

                            ${escapeHtml(
                                cliente.nome
                            )}

                        </div>

                        <div class="popup-type text-success">

                            Cliente cadastrado

                        </div>


                        <div class="popup-row">

                            <span class="popup-label">
                                Razão Social
                            </span>

                            <span class="popup-value">

                                ${escapeHtml(
                                    cliente.razaoSocial
                                )}

                            </span>

                        </div>


                        <div class="popup-row">

                            <span class="popup-label">
                                CNPJ
                            </span>

                            <span class="popup-value">

                                ${escapeHtml(
                                    cliente.cnpj
                                )}

                            </span>

                        </div>


                        <div class="popup-row">

                            <span class="popup-label">
                                Endereço
                            </span>

                            <span class="popup-value">

                                ${escapeHtml(
                                    cliente.endereco
                                )}

                            </span>

                        </div>


                        <div class="alert alert-success py-2 px-2 mt-2 mb-2 small">

                            Cliente cadastrado.
                            Não realizar nova prospecção.

                        </div>


                        <div class="d-grid">

                            <a href="${mapsUrl}"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary btn-sm">

                                <i class="fa-solid fa-diamond-turn-right me-1"></i>

                                Abrir no Maps

                            </a>

                        </div>

                    </div>
                `);


                marker.addTo(
                    clientesLayer
                );
            }
        );
    }


    // =============================================================
    // LEADS AMARELOS
    // =============================================================

    function carregarLeads() {

        leadsLayer
            .clearLayers();


        leads.forEach(
            lead => {

                const marker =
                    L.marker(
                        [
                            lead.latitude,
                            lead.longitude
                        ],
                        {
                            icon:
                                criarIcone(
                                    "#ffc107"
                                ),

                            zIndexOffset:
                                2000
                        }
                    );


                marker.bindPopup(
                    popupLead(
                        lead
                    )
                );


                marker.addTo(
                    leadsLayer
                );
            }
        );
    }


    function popupLead(
        lead) {

        const mapsUrl =
            criarUrlMaps(
                lead.latitude,
                lead.longitude
            );


        return `

            <div>

                <div class="popup-company">

                    ${escapeHtml(
                        lead.nome
                    )}

                </div>


                <div class="popup-type text-warning">

                    Lead capturado

                </div>


                <div class="popup-row">

                    <span class="popup-label">
                        CNPJ
                    </span>

                    <span class="popup-value">

                        ${escapeHtml(
                            lead.cnpj
                        )}

                    </span>

                </div>


                <div class="popup-row">

                    <span class="popup-label">
                        Endereço
                    </span>

                    <span class="popup-value">

                        ${escapeHtml(
                            lead.endereco
                        )}

                    </span>

                </div>


                <div class="popup-row">

                    <span class="popup-label">
                        Responsável
                    </span>

                    <span class="popup-value fw-bold">

                        ${escapeHtml(
                            lead.responsavel
                        )}

                    </span>

                </div>


                <div class="popup-row">

                    <span class="popup-label">
                        Capturado
                    </span>

                    <span class="popup-value">

                        ${escapeHtml(
                            lead.dataCaptura
                        )}

                    </span>

                </div>


                <div class="popup-row">

                    <span class="popup-label mb-1">
                        Status
                    </span>

                    <select id="statusLead_${lead.id}"
                            class="form-select form-select-sm">

                        ${optionStatus(
                            "Em Andamento",
                            lead.status
                        )}

                        ${optionStatus(
                            "Negociando",
                            lead.status
                        )}

                        ${optionStatus(
                            "Convertido",
                            lead.status
                        )}

                        ${optionStatus(
                            "Perdido",
                            lead.status
                        )}

                    </select>

                </div>


                <div class="popup-actions">

                    <div class="d-grid gap-2">

                        <a href="${mapsUrl}"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-primary btn-sm">

                            Abrir no Maps

                        </a>


                        <button type="button"
                                class="btn btn-warning btn-sm"
                                onclick="atualizarStatus(${lead.id})">

                            Atualizar Status

                        </button>

                    </div>

                </div>

            </div>
        `;
    }


    function optionStatus(
        valor,
        atual) {

        return `

            <option value="${valor}"

                ${
                    valor === atual
                        ? "selected"
                        : ""
                }>

                ${valor}

            </option>
        `;
    }


    // =============================================================
    // GPS COM VALIDAÇÃO DE PRECISÃO
    // =============================================================

    function usarLocalizacaoAtual() {

        if (!navigator.geolocation) {

            mostrarToast(
                "Este navegador não oferece geolocalização.",
                false
            );

            return;
        }


        const botao =
            document.getElementById(
                "btnCurrentLocation"
            );


        const gpsStatus =
            document.getElementById(
                "gpsStatus"
            );


        botao.disabled =
            true;


        botao.innerHTML =

            '<span class="spinner-border spinner-border-sm me-1"></span>Obtendo GPS...';


        gpsStatus.style.display =
            "block";


        gpsStatus.innerHTML =

            "Obtendo uma posição precisa do aparelho...";


        let melhorPosicao =
            null;


        let melhorPrecisao =
            Infinity;


        let finalizado =
            false;


        const iniciarEm =
            Date.now();


        const watchId =
            navigator.geolocation.watchPosition(

                async position => {

                    if (finalizado) {
                        return;
                    }


                    const precisao =
                        position.coords.accuracy;


                    if (precisao <
                        melhorPrecisao) {

                        melhorPrecisao =
                            precisao;

                        melhorPosicao =
                            position;
                    }


                    atualizarStatusGps(
                        precisao
                    );


                    // Excelente: aceita imediatamente.
                    if (precisao <= 30) {

                        finalizado =
                            true;

                        navigator
                            .geolocation
                            .clearWatch(
                                watchId
                            );


                        await aceitarPosicaoGps(
                            position
                        );


                        restaurarBotaoGps(
                            botao
                        );

                        return;
                    }


                    // Depois de 12 segundos,
                    // aceita até 80 m.
                    if (
                        Date.now() -
                        iniciarEm >= 12000
                    ) {

                        finalizado =
                            true;


                        navigator
                            .geolocation
                            .clearWatch(
                                watchId
                            );


                        if (
                            melhorPosicao &&
                            melhorPrecisao <= 80
                        ) {

                            await aceitarPosicaoGps(
                                melhorPosicao
                            );


                            mostrarToast(
                                `Localização aceita com precisão aproximada de ${Math.round(melhorPrecisao)} metros.`,
                                true
                            );
                        }
                        else {

                            rejeitarGpsImpreciso(
                                melhorPrecisao
                            );
                        }


                        restaurarBotaoGps(
                            botao
                        );
                    }

                },

                error => {

                    if (finalizado) {
                        return;
                    }


                    finalizado =
                        true;


                    navigator
                        .geolocation
                        .clearWatch(
                            watchId
                        );


                    restaurarBotaoGps(
                        botao
                    );


                    gpsStatus.innerHTML =

                        '<span class="gps-accuracy-bad">Não foi possível obter uma localização confiável.</span>';


                    let mensagem =
                        "Não foi possível obter sua localização.";


                    if (error.code === 1) {

                        mensagem =
                            "A permissão de localização foi negada.";
                    }


                    mostrarToast(
                        mensagem,
                        false
                    );

                },

                {
                    enableHighAccuracy:
                        true,

                    timeout:
                        20000,

                    maximumAge:
                        0
                }
            );


        // Segurança caso o dispositivo pare de enviar leituras.
        setTimeout(
            async () => {

                if (finalizado) {
                    return;
                }


                finalizado =
                    true;


                navigator
                    .geolocation
                    .clearWatch(
                        watchId
                    );


                if (
                    melhorPosicao &&
                    melhorPrecisao <= 80
                ) {

                    await aceitarPosicaoGps(
                        melhorPosicao
                    );
                }
                else {

                    rejeitarGpsImpreciso(
                        melhorPrecisao
                    );
                }


                restaurarBotaoGps(
                    botao
                );

            },

            16000
        );
    }


    function atualizarStatusGps(
        precisao) {

        const gpsStatus =
            document.getElementById(
                "gpsStatus"
            );


        let classe =
            "gps-accuracy-bad";


        let qualidade =
            "Baixa";


        if (precisao <= 30) {

            classe =
                "gps-accuracy-good";

            qualidade =
                "Excelente";
        }
        else if (precisao <= 80) {

            classe =
                "gps-accuracy-medium";

            qualidade =
                "Aceitável";
        }


        gpsStatus.innerHTML = `

            GPS:
            <span class="${classe}">

                ${qualidade}
                (${Math.round(precisao)} m)

            </span>
        `;
    }


    async function aceitarPosicaoGps(
        position) {

        selectedLatitude =
            position.coords.latitude;


        selectedLongitude =
            position.coords.longitude;


        selectedAccuracy =
            position.coords.accuracy;


        localizacaoVemDoGps =
            true;


        selectedAddress =
            "Minha localização atual";


        await obterEnderecoDaCoordenada();


        const gpsStatus =
            document.getElementById(
                "gpsStatus"
            );


        gpsStatus.innerHTML = `

            <span class="${
                selectedAccuracy <= 30
                    ? "gps-accuracy-good"
                    : "gps-accuracy-medium"
            }">

                Localização pronta:
                ±${Math.round(selectedAccuracy)} m

            </span>
        `;


        mostrarToast(
            "Localização validada. Clique em Aplicar.",
            true
        );
    }


    function rejeitarGpsImpreciso(
        precisao) {

        const gpsStatus =
            document.getElementById(
                "gpsStatus"
            );


        const valor =
            Number.isFinite(precisao)
                ? `${Math.round(precisao)} m`
                : "indisponível";


        gpsStatus.innerHTML = `

            <span class="gps-accuracy-bad">

                GPS rejeitado.
                Precisão: ${valor}

            </span>
        `;


        selectedLatitude =
            null;

        selectedLongitude =
            null;

        selectedAccuracy =
            null;


        mostrarToast(
            "A localização recebida está imprecisa demais. Vá para uma área com melhor sinal de GPS ou selecione o endereço.",
            false
        );
    }


    function restaurarBotaoGps(
        botao) {

        botao.disabled =
            false;


        botao.innerHTML = `

            <i class="fa-solid fa-location-crosshairs me-1"></i>

            Minha localização
        `;
    }


    // =============================================================
    // GEOCODIFICAÇÃO REVERSA GOOGLE
    // =============================================================

    async function obterEnderecoDaCoordenada() {

        if (
            typeof google === "undefined" ||
            !google.maps
        ) {

            return;
        }


        try {

            const geocoder =
                new google.maps.Geocoder();


            const resultado =
                await geocoder.geocode({
                    location:
                    {
                        lat:
                            selectedLatitude,

                        lng:
                            selectedLongitude
                    }
                });


            if (
                resultado.results &&
                resultado.results.length
            ) {

                selectedAddress =
                    resultado
                        .results[0]
                        .formatted_address;
            }

        }
        catch(error) {

            console.error(
                "Erro no reverse geocoding:",
                error
            );
        }
    }


    // =============================================================
    // APLICAR
    // =============================================================

    async function aplicarPesquisa() {

        if (
            selectedLatitude === null ||
            selectedLongitude === null
        ) {

            mostrarToast(
                "Selecione um endereço válido ou obtenha uma localização GPS confiável.",
                false
            );

            return;
        }


        let raio =
            parseFloat(
                document
                    .getElementById(
                        "radiusInput"
                    )
                    .value
            );


        if (!raio ||
            raio < 1) {

            raio =
                1;
        }


        if (raio > 30) {

            raio =
                30;


            document
                .getElementById(
                    "radiusInput"
                )
                .value =
                30;
        }


        desenharAreaPesquisa(
            raio
        );


        await buscarFarmacias(
            raio
        );
    }


    // =============================================================
    // CÍRCULO DE PESQUISA
    // =============================================================

    function desenharAreaPesquisa(
        raioKm) {

        if (raioCircle) {

            map.removeLayer(
                raioCircle
            );
        }


        if (centroMarker) {

            map.removeLayer(
                centroMarker
            );
        }


        if (precisaoCircle) {

            map.removeLayer(
                precisaoCircle
            );

            precisaoCircle =
                null;
        }


        raioCircle =
            L.circle(
                [
                    selectedLatitude,
                    selectedLongitude
                ],
                {
                    radius:
                        raioKm * 1000,

                    color:
                        "#0d6efd",

                    weight:
                        2,

                    fillColor:
                        "#0d6efd",

                    fillOpacity:
                        .05
                }
            )
            .addTo(map);


        const currentIcon =
            L.divIcon({

                className:
                    "",

                html:

                    '<div class="current-location-marker"></div>',

                iconSize:
                    [20,20],

                iconAnchor:
                    [10,10]
            });


        centroMarker =
            L.marker(
                [
                    selectedLatitude,
                    selectedLongitude
                ],
                {
                    icon:
                        currentIcon,

                    zIndexOffset:
                        5000
                }
            )
            .addTo(map)
            .bindPopup(
                `
                    <strong>
                        ${escapeHtml(
                            selectedAddress
                        )}
                    </strong>

                    ${
                        selectedAccuracy

                            ? `<br><small>Precisão GPS aproximada: ±${Math.round(selectedAccuracy)} m</small>`

                            : ""
                    }
                `
            );


        // Mostra a margem de erro real do GPS.
        if (
            localizacaoVemDoGps &&
            selectedAccuracy
        ) {

            precisaoCircle =
                L.circle(
                    [
                        selectedLatitude,
                        selectedLongitude
                    ],
                    {
                        radius:
                            selectedAccuracy,

                        color:
                            "#0d6efd",

                        weight:
                            1,

                        fillColor:
                            "#0d6efd",

                        fillOpacity:
                            .15
                    }
                )
                .addTo(map);
        }


        map.fitBounds(
            raioCircle.getBounds(),
            {
                padding:
                    [20,20]
            }
        );
    }


    // =============================================================
    // OVERPASS - FARMÁCIAS
    // =============================================================

    async function buscarFarmacias(
        raioKm) {

        const botao =
            document.getElementById(
                "btnAplicar"
            );


        const original =
            botao.innerHTML;


        botao.disabled =
            true;


        botao.innerHTML =

            '<span class="spinner-border spinner-border-sm me-1"></span>Buscando...';


        oportunidadesLayer
            .clearLayers();


        farmaciasEncontradas =
            [];


        document
            .getElementById(
                "kpiPossiveis"
            )
            .textContent =
            "0";


        const raioMetros =
            Math.round(
                raioKm * 1000
            );


        const query = `

            [out:json][timeout:40];

            (

                node
                    ["amenity"="pharmacy"]
                    (around:${raioMetros},${selectedLatitude},${selectedLongitude});

                way
                    ["amenity"="pharmacy"]
                    (around:${raioMetros},${selectedLatitude},${selectedLongitude});

                relation
                    ["amenity"="pharmacy"]
                    (around:${raioMetros},${selectedLatitude},${selectedLongitude});

            );

            out center tags;
        `;


        try {

            const endpoints =
            [
                "https://overpass-api.de/api/interpreter",

                "https://overpass.kumi.systems/api/interpreter"
            ];


            let resultado =
                null;


            for (
                const endpoint
                of endpoints
            ) {

                try {

                    const response =
                        await fetch(
                            endpoint,
                            {
                                method:
                                    "POST",

                                headers:
                                {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded"
                                },

                                body:
                                    "data=" +
                                    encodeURIComponent(
                                        query
                                    )
                            }
                        );


                    if (!response.ok) {
                        continue;
                    }


                    resultado =
                        await response.json();


                    break;

                }
                catch {
                }
            }


            if (!resultado) {

                throw new Error(
                    "Nenhum servidor Overpass respondeu."
                );
            }


            let candidatas =
                resultado.elements

                    .map(
                        converterFarmaciaOsm
                    )

                    .filter(
                        f =>
                            f !== null
                    );


            candidatas =
                await Promise.all(

                    candidatas.map(
                        farmacia =>
                            enriquecerFarmaciaPorCnpj(
                                farmacia
                            )
                    )
                );


            farmaciasEncontradas =
                candidatas.filter(
                    farmacia =>

                        !existeCliente(
                            farmacia
                        ) &&

                        !existeLead(
                            farmacia
                        )
                );


            farmaciasEncontradas =
                removerDuplicidades(
                    farmaciasEncontradas
                );


            desenharPossiveisLeads();


            document
                .getElementById(
                    "kpiPossiveis"
                )
                .textContent =

                farmaciasEncontradas.length;


            mostrarToast(
                `${farmaciasEncontradas.length} possíveis leads encontrados.`,
                true
            );

        }
        catch(error) {

            console.error(
                error
            );


            mostrarToast(
                "Não foi possível consultar as farmácias nesta região.",
                false
            );
        }
        finally {

            botao.disabled =
                false;


            botao.innerHTML =
                original;
        }
    }


    // =============================================================
    // CONVERTE OSM
    // =============================================================

    function converterFarmaciaOsm(
        item) {

        let latitude =
            item.lat;


        let longitude =
            item.lon;


        if (item.center) {

            latitude =
                item.center.lat;

            longitude =
                item.center.lon;
        }


        if (
            !latitude ||
            !longitude
        ) {

            return null;
        }


        const tags =
            item.tags || {};


        const nome =
            tags.name ||
            tags["name:pt"] ||
            tags.brand ||
            "Farmácia";


        const razaoSocial =
            tags.official_name ||
            tags.operator ||
            "";


        const cnpj =
            obterCnpjOsm(
                tags
            );


        return {

            osmId:
                `${item.type}_${item.id}`,

            nome:
                nome,

            razaoSocial:
                razaoSocial,

            cnpj:
                cnpj,

            endereco:
                montarEnderecoOsm(
                    tags
                ),

            latitude:
                latitude,

            longitude:
                longitude
        };
    }


    function obterCnpjOsm(
        tags) {

        const candidatos =
        [
            tags.cnpj,

            tags["contact:cnpj"],

            tags["ref:cnpj"],

            tags["tax_id"]
        ];


        for (
            const valor
            of candidatos
        ) {

            if (!valor) {
                continue;
            }


            const numeros =
                String(valor)
                    .replace(
                        /\D/g,
                        ""
                    );


            if (
                numeros.length === 14
            ) {

                return numeros;
            }
        }


        return "";
    }


    function montarEnderecoOsm(
        tags) {

        const partes =
            [];


        let rua =
            tags["addr:street"] ||
            "";


        const numero =
            tags["addr:housenumber"] ||
            "";


        if (rua) {

            if (numero) {

                rua +=
                    `, ${numero}`;
            }


            partes.push(
                rua
            );
        }


        const bairro =
            tags["addr:suburb"] ||
            tags["addr:neighbourhood"] ||
            "";


        if (bairro) {

            partes.push(
                bairro
            );
        }


        const cidade =
            tags["addr:city"] ||
            "";


        if (cidade) {

            partes.push(
                cidade
            );
        }


        const estado =
            tags["addr:state"] ||
            "";


        if (estado) {

            partes.push(
                estado
            );
        }


        const cep =
            tags["addr:postcode"] ||
            "";


        if (cep) {

            partes.push(
                `CEP ${cep}`
            );
        }


        return partes.length

            ? partes.join(
                " | "
            )

            : "Endereço não informado";
    }


    // =============================================================
    // BRASIL API
    // =============================================================

    async function enriquecerFarmaciaPorCnpj(
        farmacia) {

        if (!farmacia.cnpj) {

            return farmacia;
        }


        const cnpj =
            String(
                farmacia.cnpj
            )
            .replace(
                /\D/g,
                ""
            );


        if (
            cnpj.length !== 14
        ) {

            return farmacia;
        }


        try {

            const response =
                await fetch(
                    `https://brasilapi.com.br/api/cnpj/v1/${cnpj}`
                );


            if (!response.ok) {

                return farmacia;
            }


            const dados =
                await response.json();


            farmacia.razaoSocial =
                dados.razao_social ||
                farmacia.razaoSocial ||
                "";


            farmacia.nome =
                dados.nome_fantasia ||
                farmacia.nome;


            farmacia.cnpj =
                formatarCnpj(
                    cnpj
                );


            const endereco =
                [];


            if (dados.logradouro) {

                let logradouro =
                    dados.logradouro;


                if (dados.numero) {

                    logradouro +=
                        `, ${dados.numero}`;
                }


                endereco.push(
                    logradouro
                );
            }


            if (dados.bairro) {

                endereco.push(
                    dados.bairro
                );
            }


            if (dados.municipio) {

                endereco.push(

                    dados.uf

                        ? `${dados.municipio} - ${dados.uf}`

                        : dados.municipio
                );
            }


            if (dados.cep) {

                endereco.push(
                    `CEP ${dados.cep}`
                );
            }


            if (
                endereco.length
            ) {

                farmacia.endereco =
                    endereco.join(
                        " | "
                    );
            }


            return farmacia;

        }
        catch {

            return farmacia;
        }
    }


    function formatarCnpj(
        cnpj) {

        if (!cnpj) {

            return "Não informado";
        }


        const numeros =
            String(cnpj)
                .replace(
                    /\D/g,
                    ""
                );


        if (
            numeros.length !== 14
        ) {

            return cnpj;
        }


        return (

            numeros.substring(0,2) +
            "." +

            numeros.substring(2,5) +
            "." +

            numeros.substring(5,8) +
            "/" +

            numeros.substring(8,12) +
            "-" +

            numeros.substring(12,14)
        );
    }


    // =============================================================
    // PRIORIDADE CLIENTE > LEAD > VERMELHO
    // =============================================================

    function existeCliente(
        farmacia) {

        return clientes.some(
            cliente => {

                if (
                    farmacia.cnpj &&
                    cliente.cnpj
                ) {

                    const a =
                        String(
                            farmacia.cnpj
                        )
                        .replace(
                            /\D/g,
                            ""
                        );


                    const b =
                        String(
                            cliente.cnpj
                        )
                        .replace(
                            /\D/g,
                            ""
                        );


                    if (
                        a.length === 14 &&
                        a === b
                    ) {

                        return true;
                    }
                }


                return distanciaMetros(

                    farmacia.latitude,

                    farmacia.longitude,

                    cliente.latitude,

                    cliente.longitude

                ) <= 50;
            }
        );
    }


    function existeLead(
        farmacia) {

        return leads.some(
            lead => {

                if (
                    farmacia.cnpj &&
                    lead.cnpj &&
                    lead.cnpj !==
                    "Não informado"
                ) {

                    const a =
                        String(
                            farmacia.cnpj
                        )
                        .replace(
                            /\D/g,
                            ""
                        );


                    const b =
                        String(
                            lead.cnpj
                        )
                        .replace(
                            /\D/g,
                            ""
                        );


                    if (
                        a.length === 14 &&
                        a === b
                    ) {

                        return true;
                    }
                }


                return distanciaMetros(

                    farmacia.latitude,

                    farmacia.longitude,

                    lead.latitude,

                    lead.longitude

                ) <= 50;
            }
        );
    }


    function removerDuplicidades(
        lista) {

        const resultado =
            [];


        lista.forEach(
            item => {

                const duplicado =
                    resultado.some(
                        existente =>

                            distanciaMetros(

                                item.latitude,

                                item.longitude,

                                existente.latitude,

                                existente.longitude

                            ) <= 20
                    );


                if (!duplicado) {

                    resultado.push(
                        item
                    );
                }
            }
        );


        return resultado;
    }


