<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GeoPharma</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background-color: #eef2f5;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 0.875rem;
            color: #333;
            display: flex;
            flex-direction: column;
        }

        /* Topo Minimalista Clean */
        .header-top {
            background-color: #ffffff;
            border-bottom: 1px solid #dcdcdc;
            flex-shrink: 0;
        }

        .navbar-brand-text {
            font-weight: 700;
            font-size: 1.2rem;
            color: #222222;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .nav-clean .nav-link {
            color: #555555;
            font-weight: 500;
            font-size: 0.85rem;
            padding: 0.5rem 0.75rem;
            transition: color 0.15s ease-in-out;
        }

            .nav-clean .nav-link:hover,
            .nav-clean .nav-link.active {
                color: #000000;
            }

        .user-info {
            font-size: 0.8rem;
            color: #666666;
        }

        /* Estrutura Principal Flexível */
        .main-content {
            flex: 1 0 auto;
        }

        /* Rodapé Fixo no Fim da Tela */
        footer {
            background-color: #ffffff;
            border-top: 1px solid #dcdcdc;
            color: #777777;
            font-size: 0.75rem;
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    <header class="header-top">
        <nav class="navbar navbar-expand-lg navbar-light py-2 px-3">
            <div class="container-fluid">
                <!-- Logotipo / Marca -->
                <a class="navbar-brand-text me-4" asp-page="/Index">
                    GEOPHARMA
                </a>

                <!-- Botão Mobile Responsive -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarClean"
                        aria-controls="navbarClean" aria-expanded="false" aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links do Menu -->
                <div class="collapse navbar-collapse" id="navbarClean">
                    <ul class="navbar-nav nav-clean me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Clientes/Index">Clientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Mapas/Index">Mapa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Leads/Index">Leads Capturados</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Usuarios/Index">Usuários</a>
                        </li>
                    </ul>

                    <!-- Informações do Usuário & Sair -->
                    <div class="d-flex align-items-center gap-3 pt-2 pt-lg-0 border-top border-lg-0">
                        <span class="user-info">
                            Olá, <strong>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Usuário")</strong>
                        </span>
                        <form method="post" asp-page="/Account/Logout" class="m-0">
                            <button type="submit" class="btn btn-outline-dark btn-sm py-1 px-2" style="font-size: 0.8rem;">
                                Sair
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content py-3">
        @RenderBody()
    </main>

    <footer class="py-2 text-center">
        <div class="container-fluid">
            &copy; @DateTime.Now.Year - <strong>GeoPharma</strong> - Sistema de Geolocalização
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
