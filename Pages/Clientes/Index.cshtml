@page
@model GeoPharma.Pages.Clientes.IndexModel

@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center my-3">

        <div>
            <h4 class="fw-bold mb-0 text-dark">
                Clientes
            </h4>

            <span class="text-muted small">
                Gerenciamento de clientes cadastrados
            </span>
        </div>

        <a asp-page="Create"
           class="btn btn-dark btn-sm px-3">

            <i class="fa-solid fa-plus me-1"></i>
            Novo Cliente

        </a>

    </div>


    <div class="card border-0 shadow-sm p-3 mb-3"
         style="background-color:#ffffff; border-radius:6px;">

        <form method="get"
              class="mb-3">

            <div class="row g-2">

                <div class="col-md-6">

                    <input type="text"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           class="form-control form-control-sm"
                           placeholder="Buscar por nome, razão social, CNPJ, bairro, cidade ou região..." />

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-secondary btn-sm w-100">

                        <i class="fa-solid fa-magnifying-glass me-1"></i>
                        Filtrar

                    </button>

                </div>

            </div>

        </form>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   style="font-size:0.85rem;">

                <thead class="table-light">

                    <tr>

                        <th>
                            Nome Fantasia / Razão Social
                        </th>

                        <th>
                            CNPJ
                        </th>

                        <th>
                            Bairro / Cidade
                        </th>

                        <th>
                            Região
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end">
                            Ações
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Clientes != null &&
                        Model.Clientes.Any())
                    {
                        foreach (var item in Model.Clientes)
                        {
                            <tr>

                                <td>

                                    <strong class="d-block text-dark">
                                        @item.NomeFantasia
                                    </strong>

                                    <small class="text-muted">
                                        @item.RazaoSocial
                                    </small>

                                </td>


                                <td>
                                    @item.Cnpj
                                </td>


                                <td>

                                    <strong class="d-block text-dark">

                                        @(string.IsNullOrEmpty(item.Bairro)
                                            ? "-"
                                            : item.Bairro)

                                    </strong>

                                    <small class="text-muted">
                                        @item.Cidade / @item.Uf
                                    </small>

                                </td>


                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Regiao))
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @item.Regiao
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Sem Região
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (item.Ativo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2">
                                            Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2">
                                            Inativo
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <a asp-page="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm me-1"
                                       title="Editar">

                                        <i class="fa-regular fa-pen-to-square"></i>

                                    </a>


                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            title="Excluir"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalExcluir"
                                            onclick="prepararExclusao(
                                                @item.Id,
                                                '@item.NomeFantasia'
                                            )">

                                        <i class="fa-regular fa-trash-can"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-4 text-muted">

                                Nenhum cliente encontrado.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<div class="modal fade"
     id="modalExcluir"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-body text-center p-4">

                <div class="text-danger mb-3">

                    <i class="fa-solid fa-triangle-exclamation fa-3x"></i>

                </div>

                <h5 class="fw-bold text-dark">
                    Confirmar Exclusão
                </h5>

                <p class="text-muted small mb-3">

                    Tem certeza que deseja remover o cliente

                    <strong id="nomeExclusao"
                            class="text-dark">
                    </strong>?

                </p>


                <form method="post"
                      asp-page-handler="Delete">

                    <input type="hidden"
                           id="idExclusao"
                           name="id" />

                    <div class="d-flex justify-content-center gap-2 mt-4">

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm px-4"
                                data-bs-dismiss="modal">

                            Cancelar

                        </button>

                        <button type="submit"
                                class="btn btn-danger btn-sm px-4">

                            Confirmar Exclusão

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function prepararExclusao(id, nome) {

            document.getElementById(
                'idExclusao'
            ).value = id;

            document.getElementById(
                'nomeExclusao'
            ).innerText = nome;
        }

    </script>

}